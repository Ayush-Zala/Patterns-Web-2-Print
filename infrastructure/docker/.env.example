# PostgreSQL Configuration
POSTGRES_USER=patterns_user
POSTGRES_PASSWORD=patterns_password
POSTGRES_DB=patterns
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=patterns_redis_password
REDIS_PORT=6379

# MinIO Configuration
MINIO_ROOT_USER=patterns_admin
MINIO_ROOT_PASSWORD=patterns_minio_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=admin@patterns.local
PGADMIN_DEFAULT_PASSWORD=patterns_pgadmin_password
PGADMIN_PORT=5050

# RedisInsight Configuration
REDISINSIGHT_PORT=5540

# Timezone Configuration (User requested India time IST)
TZ=Asia/Kolkata

